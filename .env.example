# AgenticHire Environment Variables
# Copy this file to .env and fill in your values.

# --- AI API Key (at least one required) ---
MISTRAL_API_KEY=your_mistral_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# HUGGINGFACE_TOKEN=your_huggingface_token_here

# --- JWT Authentication ---
# Change this in production!
JWT_SECRET=agentichire-secret-key-change-in-production

# --- Database ---
# Default: data/agentichire.db (SQLite)
# DB_PATH=data/agentichire.db

# --- OCR / VLM Settings ---
# VLM model used for scanned CVs (default: pixtral-12b-2409)
# MISTRAL_OCR_MODEL=pixtral-12b-2409
# Max pages to process via OCR (default: 6)
# OCR_MAX_PAGES=6

# --- Security / PII Vault ---
# Cryptography Fernet 32-byte URL-safe base64 key for database encryption.
# If not provided, a temporary random key will be generated dynamically on startup.
# PII_ENCRYPTION_KEY=your_fernet_encryption_key_here


